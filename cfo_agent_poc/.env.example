# Web access
CFO_WEB_HOST=127.0.0.1
CFO_WEB_PORT=8091
# 平台数据目录：账户库 platform.sqlite 和每个用户的账本 tenants/<id>/ 都放这里，
# 留空则用 cfo_agent_poc/data。第一个在网页上注册的人自动成为管理员，之后注册需要邀请码：
#   python3 cfo_agent_poc/accounts.py invite
CFO_HOME=

# QQ Mail IMAP capture pipeline
CFO_MAIL_IMAP_HOST=imap.qq.com
CFO_MAIL_USER=your-email@qq.com
CFO_MAIL_PASSWORD=your-imap-authorization-code
CFO_MAIL_MAILBOX=INBOX
CFO_MAIL_SUBJECT=CFO_CAPTURE_SCREENSHOT

# OCR 后端
# auto：macOS 用 Apple Vision，其它系统用阿里云；也可显式写 vision / aliyun
CFO_OCR_PROVIDER=auto
# 以下仅在走阿里云时需要。务必用「只授予 OCR 权限的 RAM 子用户」，不要用主账号 AccessKey。
# 这两个值是密钥，只放在 .env（已被 .gitignore 忽略），不要写进代码或提交到仓库。
ALIBABA_CLOUD_ACCESS_KEY_ID=your-ram-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-ram-access-key-secret
CFO_OCR_REGION=cn-hangzhou
CFO_OCR_TIMEOUT_SECONDS=20

# DeepSeek chat and low-confidence classification
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_THINKING=disabled
# 仅在 DEEPSEEK_THINKING=enabled 时生效
DEEPSEEK_REASONING_EFFORT=high

# Demo
# 设为 1 走演示数据：免登录、只读，读 data/cfo-demo.sqlite（先跑 python3 demo_seed.py 生成，
# 或直接用 start_cfo_web.sh --demo）。CFO_DB_PATH 可把演示库指到别处
CFO_DEMO=0
CFO_DB_PATH=

# Runtime tuning
CFO_CHAT_TIMEOUT_SECONDS=45
CFO_PROFILE_REPORT_TIMEOUT_SECONDS=90
CFO_CLASSIFICATION_TIMEOUT_SECONDS=12
CFO_MAIL_SYNC_TIMEOUT_SECONDS=90
CFO_MAIL_SYNC_MAX_CANDIDATES=20
# 全进程同时跑的后台分类 worker 上限（每个账本最多一个，多个账本之间共享这几个名额）
CFO_CLASSIFICATION_CONCURRENCY=2
CFO_MAX_REQUEST_BODY_BYTES=12000
CFO_MAX_CHAT_MESSAGE_CHARS=600

# Troubleshooting
# 设为 1 打印每轮模型调用与工具调用的耗时。注意会把工具参数写进标准输出。
CFO_DEBUG=0
